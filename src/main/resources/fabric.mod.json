{
	"schemaVersion": 1,
	"id": "falcraft",
	"version": "${version}",
	"name": "Falcraft - 混元版",
	"description": "AI-powered 3D generation and texture remixing for Minecraft! Generate 3D models using Tencent Hunyuan 3D.",
	"authors": [
		"Falcraft Team"
	],
	"contact": {
		"homepage": "https://github.com/blendi-remade/falcraft",
		"sources": "https://github.com/blendi-remade/falcraft",
		"issues": "https://github.com/blendi-remade/falcraft/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/modid/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.falcraft.ExampleMod"
		],
		"client": [
			"com.falcraft.FalcraftClient"
		]
	},
	"mixins": [
		"modid.mixins.json",
		{
			"config": "modid.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.17.3",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}